<?xml version="1.0" encoding="utf-8"?>
<!-- A radius bigger than half the view's shortest side clips to a full stadium/pill shape -
     reliable for any widget size the OS will actually let a user resize this widget to. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#1A1A1A" />
    <corners android:radius="200dp" />
</shape>
