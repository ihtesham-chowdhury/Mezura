<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NdotWidgets" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:statusBarColor" tools:targetApi="21">?attr/colorSurface</item>
    </style>

    <!-- The instruments app. No action bar and a black window, so there's no white flash
         before Compose draws its first frame; the system bars are made transparent in code. -->
    <style name="Theme.Ndot.Instruments" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Small uppercase section heading used throughout the settings screen. -->
    <style name="SectionLabel" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SettingsCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_marginTop">16dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <style name="CardBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="CardTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <style name="CardCaption" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:alpha">0.75</item>
    </style>
</resources>
