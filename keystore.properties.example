# Copy to keystore.properties (same folder) and fill in. That file is gitignored.
# storeFile may be relative to the project root, but an absolute path outside the repo is
# safer - a key inside the project folder is easy to commit by accident.
# Note: this project's keystore has no file extension.
storeFile=C:/Users/The System Admin/keys/ndot-release
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=ndot
keyPassword=YOUR_KEY_PASSWORD
